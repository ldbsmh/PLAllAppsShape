<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No launcher activity on purpose: this module does exactly one thing and has no settings.
      Enable it in the Xposed manager and it works; there is nothing to open.

      android:icon must stay: the Xposed manager draws every module row with
      ApplicationInfo.loadIcon(), and a module without an icon shows up blank or not at all
      depending on the manager build.
    -->
    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="让 Pixel 启动器的抽屉（全部应用）图标跟随桌面图标形状设置。" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />
    </application>

</manifest>
